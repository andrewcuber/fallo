# ─────────────────────────────────────────────────────────────────────────────
# fallo — Environment Configuration Example
# Copy to .env.local (which is gitignored). Do NOT commit secrets or credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Primary AI Provider: Google Gemini Developer API (@google/genai)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Set GEMINI_API_KEY in your server-side environment (.env.local or Vercel Project Environment Variables).
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable model ID (default: gemini-2.5-flash)
# Valid Gemini Developer API models: gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Feature toggle for AI-assisted rotation generation (default: true)
FALLO_AI_ENABLED=true

# Optional timeout in milliseconds (default: 120000)
FALLO_AI_TIMEOUT_MS=120000

# Optional Fallback Provider: OpenAI-compatible HTTP endpoint
# Only used when FALLO_AI_PROVIDER is set to an OpenAI-compatible provider name
# and FALLO_AI_API_KEY is provided.
# FALLO_AI_PROVIDER=openai-compatible
# FALLO_AI_API_KEY=your-api-key-here
# FALLO_AI_BASE_URL=https://api.openai.com/v1
# FALLO_AI_MODEL=gpt-4o-mini
